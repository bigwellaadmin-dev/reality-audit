# EditorConfig keeps contributor whitespace consistent across editors.
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Markdown trailing spaces can be meaningful (two-space line breaks).
[*.md]
trim_trailing_whitespace = false

# Tab-indented files left as-is.
[Makefile]
indent_style = tab
